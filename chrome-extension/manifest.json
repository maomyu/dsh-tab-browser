{
  "manifest_version": 3,
  "name": "DSH 本机 Chrome",
  "description": "把你选中的 Chrome 网页共享给本机 DeepSeek Harness 的浏览器 Tab。",
  "version": "0.3.0",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": ["activeTab", "debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*;"
  },
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "DSH 本机 Chrome", "default_popup": "popup.html"}
}
