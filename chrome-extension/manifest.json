{
  "manifest_version": 3,
  "name": "DSH 抖音 Cookie 导出",
  "description": "经你确认后导出当前抖音站点的 Cookie，供 DSH 独立 Chrome 导入。",
  "version": "0.4.0",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": ["activeTab"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://*.douyin.com/*"],
  "incognito": "not_allowed",
  "action": {"default_title": "DSH 抖音 Cookie 导出", "default_popup": "popup.html"}
}
